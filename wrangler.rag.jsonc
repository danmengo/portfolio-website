{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danmengo-portfolio-rag",
  "main": "src/rag/worker.ts",
  "compatibility_date": "2026-09-03",
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "CHAT_ENABLED": "false", "DAILY_AI_LIMIT": "100", "RETRIEVAL_MODE": "hybrid" },
  "vectorize": [{ "binding": "VECTOR_INDEX", "index_name": "danmengo-portfolio-knowledge" }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "CHAT_RATE_LIMITER", "namespace_id": "5302026", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "CHAT_BUDGET", "class_name": "ChatBudget" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatBudget"] }]
}
